# ── Build artefacts ──────────────────────────────────────────────────────
# Every archive here is produced by a script, never hand-edited:
#   kohandezhcv.zip   — rebuilt by _tooling/wp-theme/sync-from-static.py
#   kohan-avatar.zip  — rebuilt from the plugin source beside it
# Tracking them means a 24 MB binary diff on every sync, for a file anyone
# can regenerate in one command.
*.zip
*.tar.gz

# ── Local tool state ─────────────────────────────────────────────────────
# Browse logs, a memory database and per-run scratch from the local AI
# tooling. Machine-specific, and the network logs record URLs visited.
.tooling-state/

# QA run output: audit logs, one-off check scripts and ~3 MB of before/after
# screenshots. Evidence from a past session, not something a clone needs to
# build or run the site.
.gstack/

# ── Server / OS noise ────────────────────────────────────────────────────
.DS_Store
error_log
node_modules/

# ── Scratch ──────────────────────────────────────────────────────────────
tmp-blog-import/
*.log

# Python bytecode cache from the sync script
__pycache__/

# Graphify knowledge graph — local navigation aid, not a release artifact
graphify-out/
_tooling/releases/
_tooling/backups/

# ---- Books/: one folder per title. Git keeps text, data and tools; the rest
# stays on disk only (raw sources, binaries, generated output, environments).
# Secrets are never committed, whatever folder they sit in.
Books/**/.env
Books/**/*.key
Books/**/*.pem
Books/**/state/
Books/**/.venv*/
Books/**/__pycache__/
Books/**/*.pdf
Books/**/*.docx
Books/**/*.db
Books/**/*.png
Books/**/*.jpg
Books/**/*.jpeg
Books/**/*.webp
Books/**/*.gz
Books/**/*.onnx
Books/**/*.so
Books/**/*.dylib
Books/ai-governance/Raw/
Books/ai-governance/work/
Books/ai-governance/jobs/
Books/ai-governance/pdf/
Books/ai-governance/docx/
Books/ai-governance/images/
Books/ai-governance/sources/
Books/ai-governance/qa/
Books/ai-governance/html/
Books/ics-cybersecurity/02-Standards/
Books/ics-cybersecurity/05-Archive/
