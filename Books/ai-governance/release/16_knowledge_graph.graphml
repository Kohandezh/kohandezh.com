  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0008::SEC1::B0041</data>
  <data key="d8">These core concepts of a good explanation are the basis for our four principles of explainable AI</data>
</edge>
<edge source="E:Framework:four_principles_of_explainable_ai" target="E:EvaluationMethod:explanation_measurement" id="0">
