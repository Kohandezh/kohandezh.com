  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0010::SEC2::B0050</data>
  <data key="d8">Meaningful: A system provides explanations that are understandable to the intended consumer(s).</data>
</edge>
<edge source="E:Property:meaningful_principle" target="E:OrganizationalRole:intended_consumer" id="0">
  <data key="d4">AFFECTS</data>
  <data key="d5">KDJ-AI-2026E1-P04-C29-S03-D7F773D3</data>
  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0010::SEC2.2::B0059</data>
  <data key="d8">A system fulfills the Meaningful principle if the intended recipient understands the system's explanation(s).</data>
</edge>
