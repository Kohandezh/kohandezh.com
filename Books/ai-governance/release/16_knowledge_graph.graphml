  <data key="d4">PART_OF</data>
  <data key="d5">KDJ-AI-2026E1-P01-C01-S03-8A563A55</data>
  <data key="d6">editorial</data>
  <data key="d7"></data>
  <data key="d8">محدودیت‌ها و خطرهای ذاتی</data>
</edge>
<edge source="E:Concept:uncertainty_and_error" target="E:LegalConcept:legal_standards_for_tolerable_uncertainty" id="0">
  <data key="d4">RELATED_TO</data>
  <data key="d5">KDJ-AI-2026E1-P01-C03-S15-D0B3E702</data>
  <data key="d6">source</data>
  <data key="d7">NIST-PAPER-1-FOUNDATIONAL::P0024::SEC5.1::B0190</data>
  <data key="d8">There are no agreed upon or common legal standards for what levels of uncertainty or error are tolerable.</data>
</edge>
<edge source="E:Concept:uncertainty_and_error" target="E:Concept:technological_uncertainty_and_error" id="0">
  <data key="d4">DERIVED_FROM</data>
  <data key="d5">KDJ-AI-2026E1-P01-C03-S15-D0B3E702</data>
  <data key="d6">source</data>
  <data key="d7">NIST-PAPER-1-FOUNDATIONAL::P0024::SEC5.1::B0193</data>
  <data key="d8">most AI models involve machine or deep learning techniques, which at their core calculate correlations between features.</data>
</edge>
<edge source="E:Concept:uncertainty_and_error" target="E:Concept:human_uncertainty_and_error" id="0">
  <data key="d4">DERIVED_FROM</data>
  <data key="d5">KDJ-AI-2026E1-P01-C03-S15-D0B3E702</data>
  <data key="d6">source</data>
  <data key="d7">NIST-PAPER-1-FOUNDATIONAL::P0025::SEC5.1::B0194</data>
  <data key="d8">AI systems are themselves vulnerable to ordinary human struggles to communicate clearly and avoid error-prone outcomes.</data>
</edge>
<edge source="E:Concept:uncertainty_and_error" target="E:Concept:human_technology_interaction" id="0">
  <data key="d4">DERIVED_FROM</data>
  <data key="d5">KDJ-AI-2026E1-P01-C03-S15-D0B3E702</data>
  <data key="d6">source</data>
  <data key="d7">NIST-PAPER-1-FOUNDATIONAL::P0024::SEC5.1::B0192</data>
  <data key="d8">be the result of technological or human factors, or the product of how humans and technology interact.</data>
</edge>
<edge source="E:Concept:uncertainty_and_error" target="E:Process:ai_lifecycle" id="0">
  <data key="d4">AFFECTS</data>
  <data key="d5">KDJ-AI-2026E1-P01-C03-S15-D0B3E702</data>
  <data key="d6">source</data>
  <data key="d7">NIST-PAPER-1-FOUNDATIONAL::P0024::SEC5.1::B0192</data>
  <data key="d8">Uncertainty and error in an AI system can arise at any point in the AI lifecycle.</data>
</edge>
<edge source="E:Concept:uncertainty_and_error" target="E:Risk:system_or_impact_error" id="0">
  <data key="d4">CAUSES</data>
  <data key="d5">KDJ-AI-2026E1-P01-C03-S15-D0B3E702</data>
  <data key="d6">source</data>
  <data key="d7">NIST-PAPER-1-FOUNDATIONAL::P0027::SEC5.1::B0206</data>
  <data key="d8">fed bad data or used in a novel or ill-defined situation... can lead to detectible and undetectable errors.</data>
</edge>
