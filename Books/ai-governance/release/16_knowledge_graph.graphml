  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0008::SEC1::B0042</data>
  <data key="d8">measuring components of explanations: their quality, goodness, accuracy, and limitations</data>
</edge>
<edge source="E:Framework:four_principles_of_explainable_ai" target="E:Concept:explainable_ai_system" id="0">
  <data key="d4">APPLIES_TO</data>
  <data key="d5">KDJ-AI-2026E1-P04-C29-S03-D7F773D3</data>
  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0009::SEC2::B0046</data>
  <data key="d8">Our principles apply to systems that produce explanations.</data>
</edge>
<edge source="E:Framework:four_principles_of_explainable_ai" target="E:Concept:explainable_ai" id="0">
  <data key="d4">PART_OF</data>
  <data key="d5">KDJ-AI-2026E1-P04-C29-S10-CDFE093D</data>
  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0028::SEC9::B0175</data>
  <data key="d8">We introduced four principles to encapsulate the fundamental elements for explainable AI systems.</data>
</edge>
<edge source="E:Framework:four_principles_of_explainable_ai" target="E:Concept:user_acceptance" id="0">
  <data key="d4">AFFECTS</data>
