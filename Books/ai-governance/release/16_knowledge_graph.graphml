  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0008::SEC1::B0042</data>
  <data key="d8">They provide a structure to begin measuring components of explanations</data>
</edge>
<edge source="E:Framework:four_principles_of_explainable_ai" target="E:Property:explanation_accuracy" id="0">
  <data key="d4">MEASURED_BY</data>
