<edge source="E:Property:explanation_meaningfulness" target="E:EvaluationMethod:system_causability_scale" id="0">
  <data key="d4">MEASURED_BY</data>
  <data key="d5">KDJ-AI-2026E1-P04-C29-S08-C1EADAB2</data>
  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0023::SEC7.1::B0147</data>
  <data key="d8">Holzinger et al. [46] developed the System Causability Scale (SCS) to compare explanations.</data>
</edge>
