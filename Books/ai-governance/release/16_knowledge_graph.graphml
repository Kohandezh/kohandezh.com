</edge>
<edge source="E:Framework:four_principles_of_explainable_ai" target="E:Concept:human_machine_collaboration" id="0">
  <data key="d4">APPLIES_TO</data>
  <data key="d5">KDJ-AI-2026E1-P04-C29-S10-CDFE093D</data>
  <data key="d6">source</data>
  <data key="d7">NIST-IR-8312::P0029::SEC9::B0176</data>
  <data key="d8">four principles provide a multidisciplinary framework with which to explore this type of humanmachine interaction.</data>
</edge>
