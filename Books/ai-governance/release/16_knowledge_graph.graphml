  <data key="d7">NIST-IR-8312::P0018::SEC5::B0107</data>
  <data key="d8">They claim that counterfactual explanations are sufficient.</data>
</edge>
<edge source="E:Concept:counterfactual_explanation" target="E:Concept:intellectual_property_protection" id="0">
  <data key="d4">MITIGATES</data>
